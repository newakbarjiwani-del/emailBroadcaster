# Server / App
APP_BASE_URL=http://101.50.2.56/emailBroadcaster
APP_TIMEZONE=Asia/Jakarta

# Database: sqlite | mysql
DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite

# MySQL (isi jika DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=email_broadcaster
DB_USER=root
DB_PASS=

# SMTP / Email pengirim (isi sendiri)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM_NAME=Bendahara Sekolah
MAIL_FROM_EMAIL=your-email@gmail.com

# Berapa email diproses per batch (cron tiap 2 menit)
EMAIL_BATCH_SIZE=20

# Opsional: token API (kosongkan = tanpa auth)
API_TOKEN=

# Default link tombol "Bayar Disini" (bisa di-override per request lewat paymentLink)
DEFAULT_PAYMENT_LINK=https://sdit-gemanurani.smartpayment.co.id

# Nama institusi di body email
ORGANIZATION_NAME=Yayasan Asasi Indonesia

# Logo email: path relatif ke APP_BASE_URL atau URL absolut
# Contoh: logo.png  →  http://101.50.2.56/emailBroadcaster/logo.png
MAIL_LOGO_URL=logo.png
# Warna brand ICT (header hitam + aksen biru + tombol oranye)
MAIL_BRAND_COLOR=#0a0a0a
MAIL_BRAND_ACCENT=#4fbef7
MAIL_BRAND_ORANGE=#f59d42

# Default teks tatacara pembayaran (bisa di-override per request)
DEFAULT_PAYMENT_GUIDE=PANDUAN/TATA CARA PEMBAYARAN:\nVia ATM BSI (Tipe Close Payment)\n1. Transfer ke Virtual Account (VA) yang tertera\n2. Atau klik Link Pembayaran pada email\n3. Simpan bukti pembayaran
