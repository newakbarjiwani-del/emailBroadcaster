# Server / App
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# Database: sqlite | mysql
DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite

# MySQL (isi jika DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=email_broadcaster
DB_USER=root
DB_PASS=

# SMTP / Email pengirim (isi sendiri)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM_NAME=Bendahara Sekolah
MAIL_FROM_EMAIL=your-email@gmail.com

# Berapa email diproses per batch (cron tiap 2 menit)
EMAIL_BATCH_SIZE=20

# Opsional: token API (kosongkan = tanpa auth)
API_TOKEN=

# Default teks tatacara pembayaran (bisa di-override per request)
DEFAULT_PAYMENT_GUIDE=PANDUAN PEMBAYARAN:\n1. Transfer ke Virtual Account (VA) yang tertera\n2. Atau klik Link Pembayaran pada email\n3. Simpan bukti pembayaran
